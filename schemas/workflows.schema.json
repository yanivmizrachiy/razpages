{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yanivmizrachiy.github.io/parabula-next/schemas/workflows.schema.json",
  "title": "Parabula Next Workflows Registry",
  "type": "object",
  "required": ["schemaVersion", "status", "authority", "source", "policy", "workflows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string" },
    "authority": { "type": "string" },
    "source": { "type": "string" },
    "policy": { "type": "object", "additionalProperties": true },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "status", "risk", "writeCapability", "role"],
        "additionalProperties": true,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "writeCapability": { "type": "string" },
          "role": { "type": "string" },
          "requiredPolicy": { "type": "string" }
        }
      }
    }
  }
}
