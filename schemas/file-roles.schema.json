{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yanivmizrachiy.github.io/parabula-next/schemas/file-roles.schema.json",
  "title": "Parabula Next File Roles Registry",
  "type": "object",
  "required": ["schemaVersion", "status", "authority", "source", "patterns"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string" },
    "authority": { "type": "string" },
    "source": { "type": "string" },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "labels", "risk", "decision"],
        "additionalProperties": true,
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "labels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "risk": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
