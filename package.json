{
  "name": "parabula-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview:vite": "vite preview",
    "preview": "node preview/server.mjs",
    "test": "node --test tests/contracts/*.test.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "validate:access": "node scripts/validate-access-layer.mjs",
    "validate:mobile": "node scripts/validate-mobile-runtime.mjs",
    "validate:health": "node scripts/repo-health.mjs",
    "validate:health:strict": "node scripts/repo-health.mjs --strict",
    "validate:all": "node scripts/repo-health.mjs && npm test && npm run verify && npm run validate:access && npm run validate:mobile && node scripts/app-layer-check.mjs && node scripts/audit-preview-overlaps.mjs && npm run build",
    "page:new": "node scripts/new-page.mjs",
    "rules:sync": "node scripts/sync-rules.mjs"
  },
  "devDependencies": {
    "vite": "^8.0.1"
  }
}
