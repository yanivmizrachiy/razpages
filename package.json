{
  "name": "parabula-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-algebra-z-local-assets.mjs && npm run coordinate:web",
    "build": "vite build",
    "postbuild": "node scripts/copy-static-site.mjs",
    "preview:vite": "vite preview",
    "preview": "node preview/server.mjs",
    "edit:map": "node scripts/edit-map.mjs",
    "coordinate:web": "node projects/coordinate-first-quadrant-workbook/src/build-web.mjs",
    "pythagoras:check": "node scripts/validate-pythagoras-canonical-pointer.mjs",
    "validate:pythagoras": "node scripts/validate-pythagoras-canonical-pointer.mjs",
    "systems:audit": "node scripts/audit-two-variable-systems.mjs --report",
    "systems:manifest:check": "node scripts/audit-two-variable-systems.mjs --check",
    "systems:manifest:write": "node scripts/audit-two-variable-systems.mjs --write",
    "systems:ci": "npm run systems:manifest:check && node --test tests/contracts/two-variable-systems-*.test.mjs",
    "quadratics:generate": "node scripts/generate-quadratic-equations-workbook.mjs",
    "quadratics:export": "node scripts/export-quadratic-equations-workbook.mjs",
    "validate:quadratics": "node --test tests/contracts/quadratic-equations-workbook.test.mjs",
    "algebra-z:assets": "node scripts/build-algebra-z-local-assets.mjs",
    "algebra-z:assets:check": "node scripts/build-algebra-z-local-assets.mjs --check",
    "algebra-z:assets:strict": "node scripts/build-algebra-z-local-assets.mjs --strict --check",
    "algebra-z:audit": "node scripts/audit-algebra-z-workbook.mjs",
    "algebra-z:audit:report": "node scripts/audit-algebra-z-workbook.mjs --report",
    "algebra-z:audit:strict": "node scripts/audit-algebra-z-workbook.mjs --strict-local",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:contracts": "node --test tests/contracts/root-pages.test.mjs tests/contracts/quadratic-equations-workbook.test.mjs tests/contracts/algebra-z-workbook.test.mjs tests/contracts/math-rendering-contract.test.mjs",
    "verify": "node scripts/verify.mjs",
    "validate:meta": "node scripts/generate-pages-registry.mjs && node scripts/validate-meta-schema.mjs",
    "registry:generate": "node scripts/generate-pages-registry.mjs",
    "registry:validate": "node scripts/validate-meta-schema.mjs",
    "health:report": "node scripts/repo-health-report.mjs",
    "validate:access": "node scripts/validate-access-layer.mjs",
    "validate:mobile": "node scripts/validate-mobile-runtime.mjs",
    "validate:mobile:browser": "node scripts/validate-mobile-runtime.mjs --browser",
    "validate:mobile:interactions": "node scripts/validate-mobile-interactions.mjs",
    "validate:mobile:all-pages": "node scripts/validate-mobile-all-pages.mjs --shard-index=0 --shard-count=1",
    "validate:equations:print-smoke": "node scripts/validate-equations-print-smoke.mjs",
    "validate:equations:all": "node scripts/validate-equations-suite.mjs",
    "validate:equations:public-clean": "node scripts/validate-equations-public-clean.mjs",
    "audit:equations:smart-queue": "node scripts/equations-smart-queue.mjs",
    "audit:equations:svg-plan": "node scripts/audit-equations-svg-conversion-plan.mjs",
    "page:new": "node scripts/new-page.mjs",
    "rules:check": "node scripts/single-rules-source-check.mjs",
    "curriculum:build": "node scripts/build-curriculum.mjs",
    "curriculum:check": "node scripts/build-curriculum.mjs --check",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:math-rendering": "node scripts/validate-math-rendering.mjs",
    "systems:generate": "node scripts/generate-two-variable-systems.mjs",
    "systems:check": "node scripts/generate-two-variable-systems.mjs --check",
    "validate:html": "html-validate \"עמוד-*.html\"",
    "validate:schema": "node scripts/validate-topics-schema.mjs",
    "vendorize": "node scripts/vendorize-cdn.mjs",
    "vendorize:check": "node scripts/vendorize-cdn.mjs --check",
    "doctor": "node scripts/doctor.mjs",
    "ci:all": "npm test && npm run verify && npm run validate:meta && npm run validate:schema && npm run curriculum:check && npm run validate:curriculum && npm run validate:math-rendering && npm run validate:pythagoras && npm run validate:access && npm run validate:mobile && npm run rules:check && npm run validate:html && npm run vendorize:check && npm run health:report && npm run algebra-z:audit && npm run build",
    "audit:a4:visual": "node scripts/a4-visual-audit.mjs",
    "audit:a4:utilization": "node scripts/a4-utilization-audit.mjs",
    "export:pdf:sample": "node scripts/export-pdf-sample.mjs",
    "tech:max": "npm run ci:all && npm run validate:mobile:browser && npm run validate:mobile:interactions && npm run validate:mobile:all-pages && npm run audit:a4:visual && npm run audit:a4:utilization && npm run export:pdf:sample",
    "audit:linear": "node scripts/audit-linear-pages.mjs",
    "calibrate:linear": "node scripts/calibrate-linear-pages.mjs",
    "build:linear": "node scripts/build-linear-function-pages.mjs",
    "audit:linear:print": "node scripts/audit-linear-print.mjs --all && python scripts/measure-pdf.py",
    "algebra-z:live": "node scripts/verify-algebra-z-live.mjs",
    "algebra-z:live:browser": "node scripts/verify-algebra-z-live.mjs --browser"
  },
  "devDependencies": {
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "html-validate": "^11.5.5",
    "mathjax": "^4.1.3",
    "vite": "^8.2.1"
  }
}
